# Скопируйте этот файл в .env и заполните значения.
# .env НЕ коммитится в git (см. .gitignore).

# --- Telegram ---
# Токен от @BotFather. На Windows/RPi подставляйте свой.
BOT_TOKEN=123456:AAExampleTokenReplaceMe
# Белый список telegram_id через запятую. Пусто = доступ всем (только для отладки!).
ALLOWED_TELEGRAM_IDS=111111111,222222222
# Кто может добавлять категории (/addcat). Пусто = все из ALLOWED_TELEGRAM_IDS.
ADMIN_TELEGRAM_IDS=

# --- База данных ---
# На Raspberry Pi:
DB_PATH=/home/slava/expense-tracker/data/expenses.db
# Для локальной отладки раскомментируйте строку ниже:
# DB_PATH=data/expenses.db

# --- Веб-интерфейс ---
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Прочее ---
TZ=Europe/Minsk
DEFAULT_CURRENCY=BYN
LOG_LEVEL=INFO
# Создавать категории по умолчанию при инициализации БД (1/0)
SEED_DEFAULT_CATEGORIES=1
